# -----------------------------------------------------------------------------
# DistribAI environment template  (development / local runs)
# -----------------------------------------------------------------------------
#
# Copy to `.env` in the repo root (gitignored):
#     cp .env.example .env          # Unix
#     copy .env.example .env       # Windows CMD
#
# Legend for each block:
#   [REQUIRED prod] — set explicitly before exposing the stack on a real network.
#   [AUTO dev] — if omitted, orchestrator/process code may invent safe randoms
#                or defaults; OK for localhost-only hacking.
#   [OPTIONAL] — feature gates; omission usually disables that integration.
#
# This file lists common variables read by orchestrator Python, Express
# dashboards, and workers — not every key exists in every process. Prefer
# `rg getenv` / `rg process.env` when in doubt.
# -----------------------------------------------------------------------------

# =============================================================================
# Security and auth
# =============================================================================
#
# JWT_SECRET — signing material for issued node JWTs ([AUTO dev] insecure;
#               [REQUIRED prod] must be strong, stable, secret).
JWT_SECRET=your_jwt_secret_key_change_in_production
#
# SIGNING_KEY — ledger signing key material ([AUTO dev] insecure;
#               [REQUIRED prod] rotate with care; keeps credit chain consistent).
SIGNING_KEY=your_signing_key_change_in_production
#
# DISTRIBAI_BUNDLE_DIR — directory for script tarballs from POST /admin/jobs ([OPTIONAL];
#               default runtime/bundles/ under repo root).
# DISTRIBAI_BUNDLE_DIR=
#
# DISTRIBAI_ADMIN_SECRET — Bearer token for /admin/* when auth is enforced ([REQUIRED] on public ADMIN_HOST).
# Do not reuse JWT_SECRET; node sessions and admin API use separate secrets.
# DISTRIBAI_ADMIN_SECRET=
#
# ADMIN_REQUIRE_AUTH — force Bearer auth on /admin/* even on loopback ([OPTIONAL]).
# When unset, non-loopback ADMIN_HOST (e.g. 0.0.0.0) enables auth automatically.
# ADMIN_REQUIRE_AUTH=
#
# REGISTRATION_REQUIRE_POC — reject open POST /v1/nodes/register; require challenge flow ([OPTIONAL]).
# When unset, defaults to false (independent of ADMIN_HOST / admin auth). Set true for production.
# REGISTRATION_REQUIRE_POC=
#
# Admin SSE stream limits ([OPTIONAL]) — caps /admin/stream long-poll abuse.
# ADMIN_SSE_MAX_CONNECTIONS=32
# ADMIN_SSE_MAX_PER_IP=8
# ADMIN_SSE_MAX_BYTES_PER_SEC=65536
#
# ALLOW_INSECURE_PUBLIC_BIND — break-glass only: skip startup refusal when ADMIN_HOST is public ([OPTIONAL]).
# Without this, non-loopback bind requires SIGNING_KEY, JWT_SECRET, GRPC_USE_TLS=true, DISTRIBAI_ADMIN_SECRET.
# Never use on the public internet.
# ALLOW_INSECURE_PUBLIC_BIND=

# =============================================================================
# Orchestrator HTTP + gRPC
# =============================================================================
GRPC_PORT=50051
ADMIN_PORT=8766
# Bind address for aiohttp admin/gRPC adjunct ([AUTO dev] 127.0.0.1 is typical).
ADMIN_HOST=127.0.0.1
#
# Browser CORS origins (comma-separated). Default `*` is convenient for localhost
# Unset → localhost dashboard origins only (see services_python/cors_policy.py).
# Production: list explicit HTTPS UI origins; avoid * on public binds.
# CORS_ALLOWED_ORIGINS=http://127.0.0.1:3210,http://localhost:3210
CHECKPOINT_INTERVAL=100
#
# gRPC TLS ([OPTIONAL]; default off for local mesh)
GRPC_USE_TLS=false
GRPC_TLS_CERT=server.crt
GRPC_TLS_KEY=server.key
# Worker trust bundle when verifying orchestrator gRPC TLS ([OPTIONAL]).
# GRPC_TLS_CA=server.crt
# Optional mutual TLS: orchestrator requires client certs; workers present these:
# GRPC_TLS_REQUIRE_CLIENT_CERT=true
# GRPC_TLS_CLIENT_CERT=worker.crt
# GRPC_TLS_CLIENT_KEY=worker.key
#
# Script jobs ([OPTIONAL])
# SCRIPT_UNPACK_MAX_RETRIES=2
# DISTRIBAI_DENY_EGRESS=true

# =============================================================================
# AWS / S3 — object storage hooks ([OPTIONAL])
# Omit or leave placeholder to skip blob features (code logs warnings).
# =============================================================================
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your_distribai_bucket
#
# ALLOWED_BLOB_HOSTS — HTTP(S) gradient fetch allowlist (comma-separated hostnames).
# ALLOWED_S3_BUCKETS — extra S3 bucket names beyond S3_BUCKET_NAME.
# ALLOWED_BLOB_HOSTS=127.0.0.1,localhost
# ALLOWED_S3_BUCKETS=

# =============================================================================
# Contributor dashboard Express (`client/server.js`)
# =============================================================================
PORT=3000
# LISTEN_HOST=127.0.0.1
ORCHESTRATOR_ADMIN_URL=http://127.0.0.1:8766
#
# Override static roots only if relocating assets ([OPTIONAL]).
DASHBOARD_STATIC=worker/src/dashboard/static
BENCHMARK_SCRIPT=worker/src/benchmark/bench_runner.py
#
# Node-side persisted UI secret for checksum hygiene ([AUTO dev]; set to pin).
# NODE_DATA_SECRET=
#
# Benchmark results HMAC tweak ([OPTIONAL]; default is insecure placeholder).
# BENCHMARK_SECRET=

# =============================================================================
# Operator dashboard Express (`client/orchestrator-server.js`)
# =============================================================================
# ORCH_PORT — listen port for operator UI (defaults 3212).
ORCH_PORT=3212
# Proxy target for admin API reads: built from ADMIN_HOST + ADMIN_PORT unless
# you wire a custom host via code; keep aligned with orchestrator admin bind.

# =============================================================================
# Workers / tooling
# =============================================================================
# PYTHON_BIN — pinned interpreter for dashboards spawning Python ([OPTIONAL])
# PYTHON_BIN=C:\path\to\venv\Scripts\python.exe
#
# Auto-spawn orchestrator from contributor shell ([OPTIONAL], dev only).
# AUTO_START_ORCH=1
#
DEBUG=

# Ephemeral burst workers (Colab/Kaggle) — temp state dir, in-memory auth, re-register each session.
# DISTRIBAI_EPHEMERAL=1
#
# Contributor join targets (see docs/guides/contributor-join-kit.md):
# ORCHESTRATOR_URL=your-host.example.com:50051
# ADMIN_URL=http://your-host.example.com:8766
# DISTRIBAI_INVITE_CODE=
# GRPC_TLS_CA=

# =============================================================================
# Rate limiting (`services_python/rate_limiter.py`) ([OPTIONAL])
# RATE_LIMIT_DISABLED=1
# RATE_LIMIT_RPS=

# =============================================================================
# Auto-update channel — ship desktop builds ([OPTIONAL])
# Only meaningful when distributing PyInstaller artefacts with UpdateService wired.
# See docs/guides/github-releases-setup.md if you pursue that workflow.
# =============================================================================
GITHUB_UPDATE_URL=https://github.com/your-org/distribai-releases/releases/latest/download
GITHUB_EXE_FILE=DistribAI-Node-Setup.exe
GITHUB_APP_FILE=DistribAI-Node.app.zip

# =============================================================================
# CI / pinned test secrets ([OPTIONAL] — normally leave commented)
# =============================================================================
#
# JWT_SECRET=test-jwt-secret-key-for-testing-only
# SIGNING_KEY=test-signing-key-for-testing-only
# REDIS_URL=redis://127.0.0.1:6379/0   # examples only if Redis integration wired
#
